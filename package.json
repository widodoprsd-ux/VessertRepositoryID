{
  "name": "vessertid",
  "version": "1.0.0",
  "description": "Zero-external, self-contained design system, SVG sprites, and VessertID font collection",
  "type": "module",
  "main": "./dist/internal.cjs",
  "module": "./dist/internal.js",
  "style": "./dist/internal.min.css",
  "exports": {
    ".": {
      "import": "./dist/internal.js",
      "require": "./dist/internal.cjs"
    },
    "./css": "./dist/internal.min.css",
    "./sprite": "./dist/vessert-sprite.svg",
    "./fonts/*": "./dist/assets/source/fonts/*",
    "./typeface/*": "./dist/assets/typeface/*",
    "./icons/*": "./svg/*"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/widodoprsd-ux/VessertRepositoryID"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "svg",
    "utils",
    "vessert-sprite.svg",
    "internal.min.css",
    "LICENSE",
    "package.json",
    "README.md"
  ],
  "directories": {
    "doc": "docs",
    "example": "public",
    "test": "test"
  },
  "scripts": {
    "start": "node utils/server.js -p 3000",
    "dev": "node utils/server.js -p 3000",
    "server": "node utils/server.js -p 8080",
    "build": "node internal-ui/build.js",
    "lint": "eslint internal-ui utils test src",
    "lint-fix": "eslint internal-ui utils test src --fix",
    "test": "node test/unit/VessertID.test.js && node test/e2e/puppeteer.js",
    "test-unit": "node test/unit/VessertID.test.js",
    "test-e2e": "node test/e2e/puppeteer.js",
    "make-screenshot": "node test/e2e/puppeteer.js --make-screenshot",
    "preview": "node utils/server.js -p 8080"
  },
  "keywords": [
    "vessert",
    "vessertid",
    "design-system",
    "css",
    "svg-sprite",
    "fonts",
    "zero-dependency",
    "puppeteer"
  ],
  "author": "widodoprsd-ux",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/widodoprsd-ux/VessertRepositoryID/issues"
  },
  "homepage": "https://github.com/widodoprsd-ux/VessertRepositoryID#readme",
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^22.14.0",
    "eslint": "^9.0.0",
    "puppeteer": "^24.0.0",
    "rollup": "^4.34.0",
    "typescript": "^7.0.2"
  }
}
